# Copy this file to .env and fill in your values. NEVER commit .env
NEBIUS_API_KEY=your_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Exact model ids from Token Factory (run: python list_models.py)
MODEL_REASONING=paste-nemotron-ultra-model-id-here
MODEL_FAST=paste-nemotron-super-or-nano-model-id-here
